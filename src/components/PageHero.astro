---
import type {ImageMetadata} from 'astro';
import {Picture} from 'astro:assets';
import type {Crumb} from '../layouts/Base.astro';

export type Line = {t: string; i?: boolean};

interface Props {
  kicker: string;
  /** Headline lines; `i` lines are set in italic. */
  lines: Line[];
  intro: string;
  image: {img: ImageMetadata; alt: string};
  crumbs: Crumb[];
  position?: string;
}
const {kicker, lines, intro, image, crumbs, position = 'center'} = Astro.props;
---

<section data-hero class="on-dark relative h-[82svh] min-h-[560px] overflow-hidden bg-ink text-white">
  <div data-stage class="absolute inset-0 origin-center will-change-transform">
    <Picture
      src={image.img}
      alt={image.alt}
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
      style={`object-position:${position}`}
    />
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(17_22_26/0.55),rgb(17_22_26/0.15)_35%,rgb(17_22_26/0.82))]"></div>
  </div>

  <div class="relative mx-auto flex h-full max-w-[1680px] flex-col justify-end px-5 pb-14 md:px-14 md:pb-20">
    <nav aria-label="Breadcrumb" class="caps mb-6 text-white/70">
      <ol class="flex flex-wrap gap-2">
        <li><a href="/" class="hover:text-white">Home</a></li>
        {
          crumbs.map((c, i) => (
            <li class="flex gap-2">
              <span aria-hidden="true">/</span>
              {i === crumbs.length - 1 ? <span aria-current="page" class="text-white">{c.name}</span> : <a href={c.href} class="hover:text-white">{c.name}</a>}
            </li>
          ))
        }
      </ol>
    </nav>
    <p class="caps text-glass">{kicker}</p>
    <h1 class="display mt-4 text-[clamp(48px,7.4vw,132px)] drop-shadow-[0_4px_30px_rgb(0_0_0/0.35)]">
      {lines.map((l) => <span class:list={['block', {it: l.i, 'text-white/95': !l.i}]}>{l.t}</span>)}
    </h1>
    <p class="mt-7 max-w-[56ch] text-[18px] text-white/85">{intro}</p>
  </div>
</section>
