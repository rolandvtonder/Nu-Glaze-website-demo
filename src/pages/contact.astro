---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import {featured} from '../data/gallery';
import {site} from '../data/site';

const contactPage = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Nu-Glaze',
  about: {'@id': `${site.url}/#business`},
};
const field = 'mt-2 block min-h-12 w-full border border-ink/25 bg-white px-4 py-3 text-[16px] outline-none focus:border-ink focus-visible:outline-2 focus-visible:outline-red';
---

<Base
  title="Contact Nu-Glaze — Free Quotes on Window Glazing"
  description="Get a free Nu-Glaze quote. Call or WhatsApp 073 866 2300 (RSA & exports) or 083 456 0131 (KZN), or email johan@nu-glaze.co.za. Mon–Fri 08:00–17:00."
  crumbs={[{name: 'Contact', href: '/contact/'}]}
  schema={[contactPage]}
>
  <PageHero
    kicker="Contact"
    lines={[{t: 'Tell us about'}, {t: 'your windows.', i: true}]}
    intro="Frame type, roughly how many panes, and where you are — a photo helps. You'll hear back within one business day."
    image={featured.steelDoors}
    crumbs={[{name: 'Contact', href: '/contact/'}]}
  />

  <section class="bg-paper">
    <div class="mx-auto grid max-w-[1680px] gap-16 px-5 py-20 md:px-14 md:py-28 lg:grid-cols-[1fr_1.3fr] lg:gap-24">
      <div class="space-y-10">
        <div data-reveal>
          <p class="caps text-red">Call or WhatsApp</p>
          <ul class="mt-4 space-y-5">
            {
              site.phones.map((p) => (
                <li>
                  <a href={`tel:${p.tel}`} class="display block text-[clamp(40px,4vw,64px)] hover:text-red">{p.display}</a>
                  <span class="text-ink/60">{p.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div data-reveal>
          <p class="caps text-red">Email</p>
          <a href={`mailto:${site.email}`} class="mt-3 block text-[22px] font-medium break-all hover:text-red">{site.email}</a>
          <p class="mt-1 text-ink/60">Fastest for quotes and orders.</p>
        </div>
        <div class="grid grid-cols-2 gap-8" data-reveal>
          <div>
            <p class="caps text-red">Hours</p>
            <p class="mt-3">{site.hours}</p>
            <p class="text-ink/60">Replies within 24 business hours</p>
          </div>
          <div>
            <p class="caps text-red">Based in</p>
            <p class="mt-3">{site.locality}, {site.region}</p>
            <p class="text-ink/60">Delivering nationwide & for export</p>
          </div>
        </div>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn bg-green text-white hover:bg-ink" data-reveal>Chat on WhatsApp</a>
      </div>

      <form data-contact data-email={site.email} data-whatsapp={site.whatsapp} class="on-light bg-white p-7 md:p-12" novalidate data-reveal>
        <h2 class="display text-[clamp(36px,3.6vw,56px)]">Request a free quote</h2>
        <p class="mt-3 text-ink/70">Fields marked <span class="text-red">*</span> are required. Sending opens your email or WhatsApp with the message filled in — nothing is stored on this website.</p>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          <label class="block">
            <span class="font-medium">Name <span class="text-red">*</span></span>
            <input name="name" required autocomplete="name" class={field} />
          </label>
          <label class="block">
            <span class="font-medium">Phone <span class="text-red">*</span></span>
            <input name="phone" type="tel" required autocomplete="tel" inputmode="tel" class={field} />
          </label>
          <label class="block">
            <span class="font-medium">Email</span>
            <input name="email" type="email" autocomplete="email" class={field} />
          </label>
          <label class="block">
            <span class="font-medium">Town / suburb <span class="text-red">*</span></span>
            <input name="location" required autocomplete="address-level2" class={field} />
          </label>
          <label class="block">
            <span class="font-medium">Window frames <span class="text-red">*</span></span>
            <select name="frame" required class={field}>
              <option value="">Choose one…</option>
              <option>Steel</option>
              <option>F4B hollow steel</option>
              <option>Timber</option>
              <option>Aluminium</option>
              <option>Concrete / other</option>
              <option>Not sure</option>
            </select>
          </label>
          <label class="block">
            <span class="font-medium">Approx. number of panes</span>
            <input name="panes" type="number" min="1" inputmode="numeric" class={field} />
          </label>
          <label class="block sm:col-span-2">
            <span class="font-medium">Tell us about the job</span>
            <span class="block text-[14px] text-ink/60">New glass or replacing putty? Any sizes you already know? You can attach photos once your email or WhatsApp opens.</span>
            <textarea name="message" rows="5" class={`${field} min-h-36`}></textarea>
          </label>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <button type="submit" name="via" value="email" class="btn btn-red">Send by email</button>
          <button type="submit" name="via" value="whatsapp" class="btn bg-green text-white hover:bg-ink">Send by WhatsApp</button>
        </div>
        <p data-status role="status" aria-live="polite" class="mt-4 text-[15px] text-green"></p>
        <p class="mt-6 text-[13px] text-ink/55">Your details are only used to reply to your enquiry. See our <a href="/privacy/" class="underline underline-offset-2">privacy notice</a>.</p>
      </form>
    </div>
  </section>
</Base>
