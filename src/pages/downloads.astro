---
import {Image} from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import {featured} from '../data/gallery';
import {site} from '../data/site';
import glassBreaks from '../assets/brand/glass-breaks-guide.jpg';
import ordering from '../assets/brand/ordering-glass-guide.jpg';

const docs = [
  {t: 'Technical data sheet', d: 'Full technical information on the Nu-Glaze system, 2026 edition.', href: site.docs.tds, tag: 'PDF · 2026'},
  {t: 'Product range', d: 'Every profile, colour and accessory with order codes and application sizes.', href: site.docs.range, tag: 'PDF · 2026'},
  {t: 'Warranty', d: 'What the warranty covers, test results and exclusions.', href: site.docs.warranty, tag: 'PDF'},
  {t: 'Pollsmoor case study', d: 'Article on the 101-pane installation at Pollsmoor correctional facility.', href: site.docs.pollsmoor, tag: 'PDF'},
];
const guides = [
  {t: 'Ordering glass guide', href: '/installation/ordering-glass/', img: ordering, alt: 'Preview of the Nu-Glaze ordering glass guide'},
  {t: 'If the glass breaks', href: '/installation/glass-breaks/', img: glassBreaks, alt: 'Preview of the Nu-Glaze glass breakage guide'},
];
---

<Base
  title="Downloads — Nu-Glaze Technical Data Sheet, Product Range & Warranty"
  description="Download the Nu-Glaze technical data sheet, 2026 product range, warranty document and printable installation guides."
  crumbs={[{name: 'Downloads', href: '/downloads/'}]}
>
  <PageHero
    kicker="Downloads"
    lines={[{t: 'The paperwork,'}, {t: 'in one place.', i: true}]}
    intro="Data sheets, product range, warranty and printable guides — for specifiers, contractors and DIYers."
    image={featured.reeded}
    crumbs={[{name: 'Downloads', href: '/downloads/'}]}
  />

  <section class="bg-paper">
    <div class="mx-auto max-w-[1680px] px-5 py-20 md:px-14 md:py-28">
      <ul class="grid gap-[3px] md:grid-cols-2">
        {
          docs.map((d, i) => (
            <li data-reveal style={`--d:${(i % 2) * 0.08}s`}>
              <a href={d.href} target="_blank" rel="noopener" class="group flex h-full flex-col justify-between gap-10 bg-white p-8 transition-colors hover:bg-ink hover:text-white md:p-10">
                <div>
                  <p class="caps text-red group-hover:text-glass">{d.tag}</p>
                  <h2 class="display mt-3 text-[clamp(32px,3vw,48px)]">{d.t}</h2>
                  <p class="mt-3 max-w-[48ch] opacity-75">{d.d}</p>
                </div>
                <span class="caps inline-flex items-center gap-2">Download <span aria-hidden="true">↓</span></span>
              </a>
            </li>
          ))
        }
      </ul>

      <h2 class="display mt-24 text-[clamp(40px,4.6vw,76px)]" data-reveal><span class="block">Printable</span><span class="it block text-steel">guides.</span></h2>
      <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          guides.map((g) => (
            <li data-reveal>
              <a href={g.href} class="group block">
                <Image src={g.img} alt={g.alt} widths={[400, 600]} sizes="(min-width:1024px) 25vw, 50vw" class="aspect-[1/1.41] w-full border border-line bg-white object-cover object-top transition-transform duration-500 group-hover:-translate-y-1" />
                <p class="display mt-4 text-[24px] group-hover:text-red">{g.t} →</p>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-12 max-w-[64ch] text-ink/70" data-reveal>Need test certificates or the installation manual? Email <a href={`mailto:${site.email}`} class="text-red underline underline-offset-4">{site.email}</a> — the manual is supplied free with every order.</p>
    </div>
  </section>
</Base>
