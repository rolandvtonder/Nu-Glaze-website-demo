---
import {Image} from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import {featured, photo} from '../data/gallery';
import {site} from '../data/site';
import group from '../assets/brand/reach-teach-group.jpg';
import logo from '../assets/brand/reach-teach.png';

const modules = [
  ['Technical', 'Installing and maintaining Nu-Glaze to the official installation standard — measuring, cutting, mitering, bonding and finishing.'],
  ['Business', 'Running a small business: quoting, bookkeeping and managing jobs.'],
  ['Personal development', 'The confidence and work habits to win and keep clients.'],
];
const gallery = [featured.trainingSession, featured.workshop, {img: photo(145), alt: 'Trainees watching a Nu-Glaze demonstration on a phone screen'}, {img: photo(128), alt: 'A trained installer fitting a pane into a white steel window'}, {img: photo(64), alt: 'Installer handling a glass pane during a Nu-Glaze job'}, {img: photo(116), alt: 'A Nu-Glaze installer standing beside a building he worked on'}];
const course = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Nu-Glaze Reach & Teach installer training',
  description: 'Community training to install Nu-Glaze glazing and run a small glazing business, working towards an NQF level 2 certificate of competence.',
  provider: {'@id': `${site.url}/#business`},
  educationalCredentialAwarded: 'NQF level 2 (CETA registration in progress)',
};
---

<Base
  title="Reach & Teach — Nu-Glaze Installer Training Programme"
  description="Nu-Glaze Reach & Teach trains unemployed community members, including people with disabilities, to install Nu-Glaze and run their own glazing business. 100+ trained."
  crumbs={[{name: 'Reach & Teach', href: '/reach-and-teach/'}]}
  schema={[course]}
>
  <PageHero
    kicker="Reach & Teach programme"
    lines={[{t: 'Teach a skill.'}, {t: 'Build a living.', i: true}]}
    intro="Nu-Glaze trains people from local communities to install glazing to a professional standard — and to run their own small business doing it."
    image={featured.training}
    crumbs={[{name: 'Reach & Teach', href: '/reach-and-teach/'}]}
  />

  <section class="bg-paper">
    <div class="mx-auto grid max-w-[1680px] gap-14 px-5 py-24 md:px-14 md:py-32 lg:grid-cols-[1.2fr_1fr] lg:gap-24">
      <div>
        <Image src={logo} alt="Reach and Teach programme logo: a figure climbing a green arrow" widths={[239]} class="w-[120px]" data-reveal />
        <h2 class="display mt-8 text-[clamp(44px,5.4vw,92px)]" data-reveal><span class="block">Local hands,</span><span class="it block text-green">local jobs.</span></h2>
        <div class="mt-8 max-w-[58ch] space-y-5 text-[18px] text-ink/80" data-reveal>
          <p>RDP and People's Housing Projects require local community participation. Reach & Teach makes that practical: Nu-Glaze trains community members to install the system, then supplies them with material and technical support.</p>
          <p>Training is open to unemployed people of all ages, genders and backgrounds — including people living with disabilities. Most graduates go on to work as self-employed installers, working to each client's specification, with the official installation instructions as the minimum standard.</p>
          <p>CETA registration is in progress, with the aim of awarding a certificate of competence at NQF level 2.</p>
        </div>
      </div>
      <dl class="grid grid-cols-1 gap-px self-start bg-line">
        {
          [
            ['100+', 'People trained'],
            ['All', 'Backgrounds welcome'],
            ['NQF 2', 'Target qualification level'],
          ].map(([n, l], i) => (
            <div class="flex flex-col-reverse bg-paper p-8" data-reveal style={`--d:${i * 0.06}s`}>
              <dt class="text-ink/70">{l}</dt>
              <dd class="display text-[clamp(56px,6vw,100px)] text-green">{n}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="on-dark bg-green text-white" aria-labelledby="mod-title">
    <div class="mx-auto max-w-[1680px] px-5 py-24 md:px-14 md:py-28">
      <h2 id="mod-title" class="display text-[clamp(44px,5.4vw,92px)]" data-reveal><span class="block">What the</span><span class="it block">course covers.</span></h2>
      <ol class="mt-14 grid gap-px bg-white/20 md:grid-cols-3">
        {
          modules.map(([t, d], i) => (
            <li class="bg-green p-8 md:p-10" data-reveal style={`--d:${i * 0.08}s`}>
              <span class="display text-[44px] text-white/60">0{i + 1}</span>
              <h3 class="display mt-2 text-[32px]">{t}</h3>
              <p class="mt-3 text-white/85">{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-ink" aria-label="Training photos">
    <div class="grid grid-cols-2 gap-[3px] md:grid-cols-3">
      {gallery.map((g, i) => <Image src={g.img} alt={g.alt} widths={[400, 700, 1000]} sizes="(min-width:768px) 33vw, 50vw" class="aspect-[4/3] w-full object-cover" data-reveal style={`--d:${(i % 3) * 0.06}s`} />)}
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto grid max-w-[1680px] items-center gap-12 px-5 py-24 md:px-14 lg:grid-cols-[1fr_1.2fr]">
      <Image src={group} alt="Reach and Teach programme participants on site" widths={[400, 700]} sizes="(min-width:1024px) 30vw, 100vw" class="mx-auto aspect-[1/2] max-h-[640px] w-auto object-cover" data-reveal />
      <div data-reveal>
        <p class="caps text-red">Get involved</p>
        <h2 class="display mt-4 text-[clamp(40px,4.6vw,76px)]"><span class="block">Apply for training</span><span class="it block text-steel">or partner with us.</span></h2>
        <p class="mt-6 max-w-[56ch] text-ink/80">Whether you want to learn the trade, or you run a housing project that needs local installers, get in touch. Tell us where you are and what you're looking for.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${site.email}?subject=${encodeURIComponent('Reach & Teach training')}`} class="btn btn-red">Apply for training</a>
          <a href="/contact/" class="btn btn-ghost">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</Base>
